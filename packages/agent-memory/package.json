{
  "name": "@577-industries/agent-memory",
  "version": "1.0.0",
  "description": "Bio-inspired memory for AI agents with logarithmic reinforcement, exponential decay, and composite recall scoring",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "memory",
    "ai-agent",
    "reinforcement",
    "decay",
    "recall",
    "bio-inspired",
    "embeddings",
    "semantic"
  ],
  "author": "577 Industries",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/577Industries/forge-os-libs",
    "directory": "packages/agent-memory"
  },
  "homepage": "https://www.577industries.com/forge"
}
